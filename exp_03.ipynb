        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x = [1, 2, 3, 4, 5]\n",
        "y = [10, 20, 15, 30, 25]\n",
        "\n",
        "plt.plot(x, y, marker='o')\n",
        "plt.title('Line Plot')\n",
        "plt.xlabel('X Values')\n",
        "plt.ylabel('Y Values')\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ]
